<mxfile host="drawio" type="device"><diagram name="10-test-layers" id="10-test-layers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Test layers: where the tests are and what they prove (380 tests)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Acceptance (contract): 14 scenarios S1-S14 over HTTP + WebSocket, run against every variant&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;packages/test-contracts/src/scenarios · implementations/*/tests/acceptance*.test.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="600" height="70" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;HTTP / transport: cookies, CSRF, CORS, rate + body limits, webhook signature, health, rendered Next.js pages&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;implementations/express/tests · fastify/tests · nextjs/tests/http&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="190" y="155" width="700" height="70" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Component: SPA and Next.js client components (React Testing Library, jsdom)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;packages/web-spa/tests · implementations/nextjs/tests/components&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="140" y="240" width="800" height="70" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Integration: real PostgreSQL + Elasticsearch — locking, idempotency, outbox, worker recovery, search, realtime, GraphQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;packages/server-core/tests/integration (112)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="325" width="900" height="70" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Unit: pure rules — allocation, money, state machines, eligibility, retry, validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;packages/domain/tests (53)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1000" height="70" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Run&lt;/b&gt;: make test-all (everything) · make test-packages · make express-test / fastify-test / nextjs-test · make test-scenario VARIANT=fastify S=S9&lt;br&gt;Isolated resources: ofl_core_test, ofl_express_test, ofl_fastify_test, ofl_nextjs_test (+ ES prefixes). Concurrency is never mocked." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="1000" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
