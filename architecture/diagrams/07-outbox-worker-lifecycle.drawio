<mxfile host="drawio" type="device"><diagram name="07-outbox-worker-lifecycle" id="07-outbox-worker-lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Transactional outbox and worker: job lifecycle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Business operation&lt;/b&gt;&lt;br&gt;checkout, cancel, ship, return,&lt;br&gt;adjust, price change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="70" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Same transaction&lt;/b&gt;&lt;br&gt;business rows + outbox row&lt;br&gt;+ pg_notify" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="220" height="70" as="geometry"/></mxCell><mxCell id="v4" value="PENDING&lt;br&gt;available_at ≤ now" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="150" height="50" as="geometry"/></mxCell><mxCell id="v5" value="PROCESSING&lt;br&gt;lease 30 s" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="620" y="270" width="150" height="50" as="geometry"/></mxCell><mxCell id="v6" value="DONE" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="120" height="50" as="geometry"/></mxCell><mxCell id="v7" value="FAILED&lt;br&gt;visible in admin" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="150" height="50" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="claim&lt;br&gt;(SKIP LOCKED)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="handler ok&lt;br&gt;(ES 409 counts as ok)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="RETRYABLE error&lt;br&gt;backoff 500 ms → 60 s&lt;br&gt;max 8 attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=1;entryY=0.3;" edge="1" parent="1" source="v5" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="280"/><mxPoint x="830" y="105"/></Array></mxGeometry></mxCell><mxCell id="e13" value="lease expired&lt;br&gt;(worker crashed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.3;entryX=0;entryY=0.7;" edge="1" parent="1" source="v5" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="285"/><mxPoint x="580" y="125"/></Array></mxGeometry></mxCell><mxCell id="e14" value="PERMANENT error&lt;br&gt;or attempts exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="retryJob (admin) / ofl retry-jobs&lt;br&gt;fresh attempt budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="v7" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="455"/><mxPoint x="1160" y="60"/><mxPoint x="695" y="60"/></Array></mxGeometry></mxCell><mxCell id="v16" value="&lt;b&gt;Topics and idempotent consumers&lt;/b&gt;&lt;br&gt;• &lt;b&gt;payment.authorize&lt;/b&gt; → gateway charge (key = payment id) → recordPaymentNotification&lt;br&gt;• &lt;b&gt;reservation.expire&lt;/b&gt; → cancel only if still PENDING_PAYMENT and past expiry&lt;br&gt;• &lt;b&gt;refund.process&lt;/b&gt; → gateway refund (key = refund id) → mark refund once&lt;br&gt;• &lt;b&gt;search.product_changed&lt;/b&gt; → re-read PostgreSQL → index with version_type external_gte&lt;br&gt;• &lt;b&gt;order.changed&lt;/b&gt; → no-op (metrics/audit; NOTIFY already sent)&lt;br&gt;• &lt;b&gt;sweeper&lt;/b&gt; → re-enqueues expiry for ACTIVE reservations past expires_at" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1080" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
