{
  "name": "order-fulfillment-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:create": "tsx scripts/create-databases.ts",
    "codegen": "pnpm --filter @ofl/graphql-types codegen",
    "dev:express": "pnpm --filter @ofl/express dev",
    "start:express": "pnpm --filter @ofl/express start",
    "seed:express": "pnpm --filter @ofl/express seed",
    "reset:express": "pnpm --filter @ofl/express reset",
    "build:express": "pnpm --filter @ofl/express build",
    "typecheck:express": "pnpm --filter @ofl/express typecheck",
    "lint:express": "pnpm --filter @ofl/express lint",
    "test:express": "pnpm --filter @ofl/express test",
    "dev:fastify": "pnpm --filter @ofl/fastify dev",
    "start:fastify": "pnpm --filter @ofl/fastify start",
    "seed:fastify": "pnpm --filter @ofl/fastify seed",
    "reset:fastify": "pnpm --filter @ofl/fastify reset",
    "build:fastify": "pnpm --filter @ofl/fastify build",
    "typecheck:fastify": "pnpm --filter @ofl/fastify typecheck",
    "lint:fastify": "pnpm --filter @ofl/fastify lint",
    "test:fastify": "pnpm --filter @ofl/fastify test",
    "dev:nextjs": "pnpm --filter @ofl/nextjs dev",
    "start:nextjs": "pnpm --filter @ofl/nextjs start",
    "seed:nextjs": "pnpm --filter @ofl/nextjs seed",
    "reset:nextjs": "pnpm --filter @ofl/nextjs reset",
    "build:nextjs": "pnpm --filter @ofl/nextjs build",
    "typecheck:nextjs": "pnpm --filter @ofl/nextjs typecheck",
    "lint:nextjs": "pnpm --filter @ofl/nextjs lint",
    "test:nextjs": "pnpm --filter @ofl/nextjs test",
    "dev:nestjs": "pnpm --filter @ofl/nestjs dev",
    "start:nestjs": "pnpm --filter @ofl/nestjs start",
    "seed:nestjs": "pnpm --filter @ofl/nestjs seed",
    "reset:nestjs": "pnpm --filter @ofl/nestjs reset",
    "build:nestjs": "pnpm --filter @ofl/nestjs build",
    "typecheck:nestjs": "pnpm --filter @ofl/nestjs typecheck",
    "lint:nestjs": "pnpm --filter @ofl/nestjs lint",
    "test:nestjs": "pnpm --filter @ofl/nestjs test",
    "test:packages": "pnpm --filter \"./packages/**\" test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "bench:explain": "tsx scripts/bench/explain-my-orders.ts",
    "bench": "tsx scripts/bench/run-benchmarks.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint:scripts": "eslint scripts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/node": "26.6.10",
    "eslint": "10.15.0",
    "jest": "30.5.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "@ofl/server-core": "workspace:*",
    "@ofl/graphql-types": "workspace:*",
    "graphql": "17.1.0"
  }
}
