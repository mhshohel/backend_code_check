# Next.js variant. Copy to .env (read by `next`, the realtime service, the worker, and the `ofl` CLI).
# NODE_ENV is not set here: `next dev` uses development, `next start` production.
DATABASE_URL=postgresql://shohelshamim@localhost:5432/ofl_nextjs
ELASTICSEARCH_URL=http://127.0.0.1:9200
ES_INDEX_PREFIX=ofl_nextjs_
# Must differ from the built-in development default, because `pnpm start` runs in production mode.
PAYMENT_WEBHOOK_SECRET=nextjs-local-webhook-secret-change-me
RESERVATION_TTL_SECONDS=900
SESSION_TTL_SECONDS=28800
ENABLE_QUERY_COUNT=false
LOG_LEVEL=info
DB_POOL_MAX=10

# Ports: app 4300, realtime (graphql-ws) 4301, worker health 4302.
# HOST is the interface of the realtime service and the worker health server (default 127.0.0.1).
HOST=127.0.0.1
PORT=4300
REALTIME_PORT=4301
WORKER_HEALTH_PORT=4302
# Extra public origins of THIS app (comma-separated), e.g. the hostname a reverse proxy serves it under.
# They are first-party, not CORS clients: /api/* accepts requests whose Origin is the request's own origin
# or one of these, and never answers cross-origin preflights or sends Access-Control-Allow-* headers.
# The realtime WebSocket allows http://localhost:PORT, http://127.0.0.1:PORT and these.
APP_ORIGIN=
# Set to true only when exactly one trusted reverse proxy in front of the app appends the client address
# to X-Forwarded-For. Otherwise rate limits use one shared bucket per route (plus a per-account login limit).
TRUST_PROXY=false
# Browser-visible realtime endpoint. When unset, the page derives ws://<host the page was loaded from>:REALTIME_PORT/graphql,
# which keeps the cookie host identical (cookies are host-scoped, not port-scoped).
# REALTIME_PUBLIC_URL=ws://localhost:4301/graphql

# Test only: honored only when NODE_ENV=test (shared acceptance suite).
RATE_LIMIT_DISABLED=false
NEXT_TELEMETRY_DISABLED=1
