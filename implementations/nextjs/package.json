{
  "name": "@ofl/nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 node scripts/run-services.mjs dev",
    "start": "NEXT_TELEMETRY_DISABLED=1 node scripts/run-services.mjs start",
    "seed": "ofl-seed --profile demo",
    "reset": "ofl reset && ofl-seed --profile demo",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/bundle-services.mjs",
    "test": "NEXT_TELEMETRY_DISABLED=1 next build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --config ../../eslint.config.js app modules worker tests scripts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns route-handlers tests/http tests/acceptance"
  },
  "dependencies": {
    "@ofl/server-core": "workspace:*",
    "@ofl/domain": "workspace:*",
    "@ofl/graphql-types": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@reduxjs/toolkit": "2.15.0",
    "react-redux": "9.3.1",
    "urql": "5.0.4",
    "@urql/core": "6.0.3",
    "graphql-ws": "6.4.3",
    "graphql": "17.1.0",
    "graphql-yoga": "6.1.1",
    "ws": "8.23.0",
    "server-only": "0.0.1",
    "pg": "8.23.1",
    "@node-rs/argon2": "2.2.2",
    "@elastic/elasticsearch": "9.5.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "@graphql-typed-document-node/core": "3.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "jest-environment-jsdom": "30.5.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "@ofl/test-contracts": "workspace:*",
    "@ofl/test-fixtures": "workspace:*",
    "wonka": "6.3.6"
  }
}
