{
  "name": "@ofl/fastify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "start:worker": "node --enable-source-maps dist/worker/main.js",
    "seed": "ofl-seed --profile demo",
    "reset": "ofl reset && ofl-seed --profile demo",
    "build": "vite build --config web/vite.config.ts && node scripts/build.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint api web worker tests scripts",
    "start:api": "node --enable-source-maps dist/api/server.js"
  },
  "dependencies": {
    "@ofl/server-core": "workspace:*",
    "@ofl/web-spa": "workspace:*",
    "@ofl/domain": "workspace:*",
    "@ofl/graphql-types": "workspace:*",
    "fastify": "5.12.8",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.12",
    "@fastify/websocket": "11.3.7",
    "graphql-yoga": "6.1.1",
    "graphql-ws": "6.4.3",
    "graphql": "17.1.0",
    "ws": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "fastify-plugin": "6.0.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@elastic/elasticsearch": "9.5.1",
    "@node-rs/argon2": "2.2.2",
    "dataloader": "2.2.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "pino-pretty": "13.2.0",
    "@ofl/test-contracts": "workspace:*",
    "@ofl/test-fixtures": "workspace:*"
  }
}
