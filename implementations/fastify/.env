# Fastify variant. Copy to .env (cp .env.example .env).
NODE_ENV=development
DATABASE_URL=postgresql://shohelshamim@localhost:5432/ofl_fastify
ELASTICSEARCH_URL=http://127.0.0.1:9200
ES_INDEX_PREFIX=ofl_fastify_
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
RESERVATION_TTL_SECONDS=900
SESSION_TTL_SECONDS=28800
ENABLE_QUERY_COUNT=false
LOG_LEVEL=info

# Ports (requirements §11)
PORT=4200
WORKER_PORT=4202
HOST=127.0.0.1
# Browser origins allowed by CORS and the WebSocket Origin check.
CORS_ORIGINS=http://localhost:4201,http://localhost:4200
