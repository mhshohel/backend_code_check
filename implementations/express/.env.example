# Express variant. Copy to .env (git-ignored). `pnpm seed`, `pnpm dev` and
# `pnpm start` read this file. Ports and names: docs/requirements.md §11.
NODE_ENV=development
DATABASE_URL=postgresql://shohelshamim@localhost:5432/ofl_express
ELASTICSEARCH_URL=http://127.0.0.1:9200
ES_INDEX_PREFIX=ofl_express_
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
RESERVATION_TTL_SECONDS=900
SESSION_TTL_SECONDS=28800
LOG_LEVEL=info
# Enables the x-ofl-debug-query-count header (scenario S12). Keep off in production.
ENABLE_QUERY_COUNT=false

# Express-specific
PORT=9001
HOST=127.0.0.1
WORKER_HEALTH_PORT=9004
# Browser origins for CORS and the WebSocket Origin check (Vite dev server, built app).
WEB_ORIGINS=http://localhost:9002,http://localhost:9001
