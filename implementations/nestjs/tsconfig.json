{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    // NestJS decorators. No emitDecoratorMetadata: tsx and esbuild cannot emit
    // it, so every constructor dependency is declared with @Inject(TOKEN).
    "experimentalDecorators": true
  },
  "include": ["api", "web", "worker", "tests", "scripts"],
  "exclude": ["web/dist", "dist"]
}
