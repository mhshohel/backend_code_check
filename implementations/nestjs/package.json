{
  "name": "@ofl/nestjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-all.mjs dev",
    "start": "NODE_ENV=production node scripts/run-all.mjs start",
    "seed": "ofl-seed --profile demo",
    "reset": "ofl reset && ofl-seed --profile demo",
    "build": "vite build --config web/vite.config.ts && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint api web worker tests scripts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@ofl/server-core": "workspace:*",
    "@ofl/web-spa": "workspace:*",
    "@ofl/domain": "workspace:*",
    "@ofl/graphql-types": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "cookie-parser": "1.4.7",
    "express-rate-limit": "8.7.5",
    "graphql-yoga": "6.1.1",
    "graphql-ws": "6.4.3",
    "graphql": "17.1.0",
    "ws": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@elastic/elasticsearch": "9.5.1",
    "@node-rs/argon2": "2.2.2",
    "dataloader": "2.2.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "pino-pretty": "13.2.0",
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@ofl/test-contracts": "workspace:*",
    "@ofl/test-fixtures": "workspace:*"
  }
}
