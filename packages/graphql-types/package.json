{
  "name": "@ofl/graphql-types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./operations": "./src/generated/operations.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts && tsx scripts/embed-schema.ts",
    "test": "echo 'graphql-types: generated code, covered by consumers'",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "echo 'graphql-types: generated code is not linted'",
    "build": "pnpm codegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "graphql": "17.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typed-document-node": "8.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-operations": "7.0.2",
    "@graphql-codegen/typescript-resolvers": "7.0.1"
  }
}
