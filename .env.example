# Shared defaults for local development. Copy to .env only if you need to
# override something; every implementation has its own .env.example with
# its own database, index prefix, and ports.

# PostgreSQL on the host. Local trust authentication, no password.
PGHOST=localhost
PGPORT=5432
PGUSER=shohelshamim

# Elasticsearch from compose.yaml (pnpm infra:up).
ELASTICSEARCH_URL=http://127.0.0.1:9200
